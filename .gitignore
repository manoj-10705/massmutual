# ============================================
# MassMutual Financial Pipeline — .gitignore
# ============================================

# Node / Frontend
node_modules/
dist/
dist-ssr/
*.local
package-lock.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
build/
*.egg

# Virtual environments
.venv/
airflow_venv/
venv/
env/

# Airflow runtime artifacts
airflow/airflow.db
airflow/logs/
airflow/airflow-webserver.pid
airflow/standalone_admin_password.txt
airflow/airflow.cfg
airflow/webserver_config.py

# Spark output
*.parquet/
spark/output/

# IDE
.idea/
.vscode/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# OS
.DS_Store
Thumbs.db

# Logs & debug files
*.log
*.txt
!requirements.txt
!README.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Archives & binaries
*.zip
*.tar.gz

# Environment & secrets
.env

# Large/duplicate data files
dataset/

# Docker overrides
docker-compose.override.yml

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
*.cover

# Gemini / AI
.gemini/
