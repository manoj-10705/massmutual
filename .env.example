# ============================================
# MassMutual Financial Pipeline — Environment
# Copy this file to .env and fill in your values
#   cp .env.example .env
# ============================================

# PostgreSQL — Application Database
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# PostgreSQL — Airflow Metadata (separate instance)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# Application Database
APP_DB_NAME=massmutual
APP_DB_USER=massmutual
APP_DB_PASSWORD=change_me_in_production

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_in_production

# Kafka
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=market-data

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production

# Finnhub (sign up free at https://finnhub.io/)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Gemini AI (get key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Spark
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_REST_URL=http://spark-master:6066

# API Authentication (generate with: python -c "import secrets; print(secrets.token_hex(32))")
API_SECRET_KEY=your_api_secret_key_here

# Tickers to track
TICKERS=1155.KL,BINANCE:BTCUSDT
